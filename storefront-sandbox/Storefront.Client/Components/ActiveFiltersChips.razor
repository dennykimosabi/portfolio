<div class="filter-chips @Class" @attributes="AdditionalAttributes">
    @if (Year > 0)
    {
        <SfChip OnRemove="@OnRemoveYear" RemoveLabel="Remove year">Year: @Year</SfChip>
    }
    @if (UkeyMake > 0)
    {
        <SfChip OnRemove="@OnRemoveMake" RemoveLabel="Remove make">Make: @(string.IsNullOrWhiteSpace(MakeName) ? "Make" : MakeName)</SfChip>
    }
    @if (UkeyModel > 0)
    {
        <SfChip OnRemove="@OnRemoveModel" RemoveLabel="Remove model">Model: @(string.IsNullOrWhiteSpace(ModelName) ? "Model" : ModelName)</SfChip>
    }
    @if (UkeyDriveline > 0)
    {
        <SfChip OnRemove="@OnRemoveDriveline" RemoveLabel="Remove driveline">Driveline: @(string.IsNullOrWhiteSpace(DrivelineName) ? "Driveline" : DrivelineName)</SfChip>
    }
    @if (UkeyTrimLevel > 0)
    {
        <SfChip OnRemove="@OnRemoveTrim" RemoveLabel="Remove trim">Trim: @(string.IsNullOrWhiteSpace(TrimLevelName) ? "Trim" : TrimLevelName)</SfChip>
    }
    @if (UkeyCategory > 0)
    {
        <SfChip OnRemove="@OnRemoveCategory" RemoveLabel="Remove category">Category: @(string.IsNullOrWhiteSpace(CategoryName) ? "Category" : CategoryName)</SfChip>
    }
</div>
