<div class="filter-chips @Class" @attributes="AdditionalAttributes">
    @if (Year > 0)
    {
        <span class="filter-chip">Year: @Year <button type="button" class="chip-close" aria-label="Remove year" @onclick="OnRemoveYear">×</button></span>
    }
    @if (UkeyMake > 0)
    {
        <span class="filter-chip">Make: @(string.IsNullOrWhiteSpace(MakeName) ? "Make" : MakeName) <button type="button" class="chip-close" aria-label="Remove make" @onclick="OnRemoveMake">×</button></span>
    }
    @if (UkeyModel > 0)
    {
        <span class="filter-chip">Model: @(string.IsNullOrWhiteSpace(ModelName) ? "Model" : ModelName) <button type="button" class="chip-close" aria-label="Remove model" @onclick="OnRemoveModel">×</button></span>
    }
    @if (UkeyDriveline > 0)
    {
        <span class="filter-chip">Driveline: @(string.IsNullOrWhiteSpace(DrivelineName) ? "Driveline" : DrivelineName) <button type="button" class="chip-close" aria-label="Remove driveline" @onclick="OnRemoveDriveline">×</button></span>
    }
    @if (UkeyTrimLevel > 0)
    {
        <span class="filter-chip">Trim: @(string.IsNullOrWhiteSpace(TrimLevelName) ? "Trim" : TrimLevelName) <button type="button" class="chip-close" aria-label="Remove trim" @onclick="OnRemoveTrim">×</button></span>
    }
    @if (UkeyCategory > 0)
    {
        <span class="filter-chip">Category: @(string.IsNullOrWhiteSpace(CategoryName) ? "Category" : CategoryName) <button type="button" class="chip-close" aria-label="Remove category" @onclick="OnRemoveCategory">×</button></span>
    }
</div>
