@if (Layout == VehiclePickerLayout.Panel)
{
    <div class="vehicle-picker vehicle-picker-panel @Class" @attributes="AdditionalAttributes">
        <button class="vehicle-selector-btn @(_panelOpen ? "is-open" : "") @(CurrentGarageVehicle is not null ? "has-vehicle" : "")"
                @onclick="TogglePanel"
                aria-label="@PanelButtonLabel"
                aria-expanded="@_panelOpen"
                title="@PanelButtonLabel">
            @if (CurrentGarageVehicle is not null)
            {
                <svg class="selector-car-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M23.9691 11.3265C23.9891 11.3806 24 11.439 24 11.5V12.2192C24 12.6781 23.6877 13.0781 23.2425 13.1894L22 13.5V21C22 21.5523 21.5523 22 21 22H20C19.4477 22 19 21.5523 19 21V20H5V21C5 21.5523 4.55228 22 4 22H3C2.44772 22 2 21.5523 2 21V13.5L0.757464 13.1894C0.312297 13.0781 0 12.6781 0 12.2192V11.5C0 11.2239 0.223858 11 0.5 11H2L4.4805 5.21216C4.79566 4.47679 5.51874 4 6.31879 4H10.252C10.0875 4.63924 10 5.3094 10 6H6L4.54856 9.62861C4.50131 9.74673 4.47703 9.87278 4.47703 10C4.47703 10.5523 4.92475 11 5.47703 11H11.7546C12.4047 11.8109 13.2094 12.4925 14.124 13H4V18H20V13.748C21.5569 13.3472 22.9304 12.4896 23.9691 11.3265ZM9.68588 16.2643C8.87868 14.7548 7.31672 14 5 14V16C5 16.5523 5.44772 17 6 17H9.24496C9.3272 17 9.40818 16.9797 9.4807 16.9409C9.72418 16.8107 9.81602 16.5078 9.68582 16.2643H9.68588ZM19 14V16C19 16.5523 18.5523 17 18 17H14.755C14.6728 17 14.5918 16.9797 14.5193 16.9409C14.2758 16.8107 14.184 16.5078 14.3142 16.2643H14.3141C15.1213 14.7548 16.6833 14 19 14Z" fill="currentColor" />
                    <path d="M18 0C21.3137 0 24 2.68629 24 6C24 9.31371 21.3137 12 18 12C14.6863 12 12 9.31371 12 6C12 2.68629 14.6863 0 18 0ZM17.166 7.32129L15.1035 5.25879L14.5146 5.84766L17.166 8.5L21.5859 4.08008L20.9961 3.49121L17.166 7.32129Z" fill="#268000" />
                </svg>
            }
            else
            {
                <svg class="selector-car-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M19 20H5V21C5 21.5523 4.55228 22 4 22H3C2.44772 22 2 21.5523 2 21V13.5L0.757464 13.1894C0.312297 13.0781 0 12.6781 0 12.2192V11.5C0 11.2239 0.223858 11 0.5 11H2L4.4805 5.21216C4.79566 4.47679 5.51874 4 6.31879 4H17.6812C18.4813 4 19.2043 4.47679 19.5195 5.21216L22 11H23.5C23.7761 11 24 11.2239 24 11.5V12.2192C24 12.6781 23.6877 13.0781 23.2425 13.1894L22 13.5V21C22 21.5523 21.5523 22 21 22H20C19.4477 22 19 21.5523 19 21V20ZM20 18V13H4V18H20ZM18.523 11H5.47703C4.92475 11 4.47703 10.5523 4.47703 10C4.47703 9.87278 4.50131 9.74673 4.54856 9.62861L6 6H18L19.4514 9.62861C19.6566 10.1414 19.4071 10.7234 18.8944 10.9285C18.7762 10.9757 18.6502 11 18.523 11ZM5 14C7.31672 14 8.87868 14.7548 9.68588 16.2643H9.68582C9.81602 16.5078 9.72418 16.8107 9.4807 16.9409C9.40818 16.9797 9.3272 17 9.24496 17H6C5.44772 17 5 16.5523 5 16V14ZM19 16V14C16.6833 14 15.1213 14.7548 14.3141 16.2643H14.3142C14.184 16.5078 14.2758 16.8107 14.5193 16.9409C14.5918 16.9797 14.6728 17 14.755 17H18C18.5523 17 19 16.5523 19 16Z" fill="currentColor" />
                </svg>
            }
        </button>

        @if (_panelOpen)
        {
            <div class="vehicle-panel-overlay" @onclick="ClosePanel"></div>

            <div class="vehicle-panel">
              @if (!_showAddVehicle && HasGarage)
              {
                <div class="vehicle-panel-header">
                    <span class="vehicle-panel-title">Your Garage</span>
                    <button class="vehicle-panel-clear" @onclick="ClearGarage">Clear All</button>
                </div>

                <ul class="vehicle-garage-list">
                    @foreach (var v in Garage.Vehicles)
                    {
                        <li class="vehicle-garage-item">
                            <GarageVehicleCard @key="v.Ukey" Vehicle="v" OnSelected="ClosePanel" />
                        </li>
                    }
                </ul>

                <button type="button" class="vehicle-panel-addnew" @onclick="ShowAddVehicle">+ Add New Vehicle</button>
              }
              else
              {
                <div class="vehicle-panel-header">
                    <span class="vehicle-panel-title">Select Your Vehicle</span>
                    @if (HasGarage)
                    {
                        <button class="vehicle-panel-clear" @onclick="ShowGarage">&larr; Garage</button>
                    }
                    else if (IsVehicleComplete)
                    {
                        <button class="vehicle-panel-clear" @onclick="Clear">Clear</button>
                    }
                </div>

                <div class="vehicle-panel-body">
                    <div class="vehicle-select-group">
                        <label class="vehicle-select-label" for="vp-year">Year</label>
                        <SearchableSelect Id="vp-year"
                                          Placeholder="@(_loadingYears ? "Loading..." : "Select Year")"
                                          SearchPlaceholder="Search years..."
                                          Options="@((Years ?? []).Select(yr => new SearchableSelectOption(yr.SimpleString, yr.SimpleString)).ToList())"
                                          Value="@_selectedYear"
                                          ValueChanged="OnYearChanged"
                                          Disabled="@_loadingYears" />
                    </div>

                    <div class="vehicle-select-group">
                        <label class="vehicle-select-label" for="vp-model">Model</label>
                        <SearchableSelect @ref="_modelSelect"
                                          Id="vp-model"
                                          Placeholder="@(_loadingModels ? "Loading..." : "Select Model")"
                                          SearchPlaceholder="Search models..."
                                          Options="@(_models.Select(mdl => new SearchableSelectOption(mdl.Ukey.ToString(), DisplayText(mdl))).ToList())"
                                          Value="@_selectedModel"
                                          ValueChanged="OnModelChanged"
                                          Disabled="@(string.IsNullOrEmpty(_selectedYear) || _loadingModels)" />
                    </div>

                    @if (ShowDrivelineAndTrim)
                    {
                        <div class="vehicle-select-group">
                            <label class="vehicle-select-label" for="vp-driveline">Driveline</label>
                            <SearchableSelect @ref="_drivelineSelect"
                                              Id="vp-driveline"
                                              Placeholder="@(_loadingDrivelines ? "Loading..." : "Select Driveline")"
                                              SearchPlaceholder="Search drivelines..."
                                              Options="@(_drivelines.Select(dl => new SearchableSelectOption(dl.Ukey.ToString(), DisplayText(dl))).ToList())"
                                              Value="@_selectedDriveline"
                                              ValueChanged="OnDrivelineChanged"
                                              Disabled="@(string.IsNullOrEmpty(_selectedModel) || _loadingDrivelines)" />
                        </div>

                        <div class="vehicle-select-group">
                            <label class="vehicle-select-label" for="vp-trimlevel">Trim Level</label>
                            <SearchableSelect @ref="_trimLevelSelect"
                                              Id="vp-trimlevel"
                                              Placeholder="@(_loadingTrimLevels ? "Loading..." : "Select Trim")"
                                              SearchPlaceholder="Search trim levels..."
                                              Options="@(_trimLevels.Select(tl => new SearchableSelectOption(tl.Ukey.ToString(), DisplayText(tl))).ToList())"
                                              Value="@_selectedTrimLevel"
                                              ValueChanged="OnTrimLevelChanged"
                                              Disabled="@(string.IsNullOrEmpty(_selectedDriveline) || _loadingTrimLevels)" />
                        </div>
                    }

                    <button class="vehicle-panel-submit"
                            disabled="@(!IsVehicleComplete)"
                            @onclick="Submit">
                        @ResolvedSubmitLabel
                    </button>
                </div>

                <div class="vehicle-panel-vin">
                    <div class="vehicle-panel-vin-divider">
                        <span>or search by VIN</span>
                    </div>
                    <div class="vehicle-panel-vin-row">
                        <input type="text"
                               class="vehicle-vin-input"
                               placeholder="Enter your 17-character VIN"
                               maxlength="17"
                               @bind="_vinInput"
                               @bind:event="oninput"
                               @onkeydown="OnVinKeyDown" />
                        <button class="vehicle-vin-submit"
                                disabled="@(_vinInput.Length < 17)"
                                @onclick="SearchVin">
                            Search VIN
                        </button>
                    </div>
                </div>
              }
            </div>
        }
    </div>
}
else
{
    <section class="vehicle-picker vehicle-picker-inline @Class" @attributes="AdditionalAttributes" aria-label="Choose your vehicle">
        <div class="vehicle-picker-inline-top">
            <h2 class="vehicle-picker-inline-title">@((MarkupString)ResolvedTitle)</h2>
            <div class="vehicle-picker-inline-vin">
                <input type="text"
                       class="vehicle-vin-input"
                       placeholder="Enter VIN"
                       maxlength="17"
                       @bind="_vinInput"
                       @bind:event="oninput"
                       @onkeydown="OnVinKeyDown"
                       aria-label="Search by VIN" />
            </div>
        </div>

        <div class="vehicle-picker-inline-row">
            <div class="vehicle-select-group">
                <label class="vehicle-select-label" for="vp-year-inline">Year</label>
                <SearchableSelect Id="vp-year-inline"
                                  Placeholder="@(_loadingYears ? "Loading..." : "Year")"
                                  SearchPlaceholder="Search years..."
                                  Options="@((Years ?? []).Select(yr => new SearchableSelectOption(yr.SimpleString, yr.SimpleString)).ToList())"
                                  Value="@_selectedYear"
                                  ValueChanged="OnYearChanged"
                                  Disabled="@_loadingYears" />
            </div>

            <div class="vehicle-select-group">
                <label class="vehicle-select-label" for="vp-model-inline">Model</label>
                <SearchableSelect @ref="_modelSelect"
                                  Id="vp-model-inline"
                                  Placeholder="@(_loadingModels ? "Loading..." : "Model")"
                                  SearchPlaceholder="Search models..."
                                  Options="@(_models.Select(mdl => new SearchableSelectOption(mdl.Ukey.ToString(), DisplayText(mdl))).ToList())"
                                  Value="@_selectedModel"
                                  ValueChanged="OnModelChanged"
                                  Disabled="@(string.IsNullOrEmpty(_selectedYear) || _loadingModels)" />
            </div>

            @if (ShowDrivelineAndTrim)
            {
                <div class="vehicle-select-group">
                    <label class="vehicle-select-label" for="vp-driveline-inline">Driveline</label>
                    <SearchableSelect @ref="_drivelineSelect"
                                      Id="vp-driveline-inline"
                                      Placeholder="@(_loadingDrivelines ? "Loading..." : "Driveline")"
                                      SearchPlaceholder="Search drivelines..."
                                      Options="@(_drivelines.Select(dl => new SearchableSelectOption(dl.Ukey.ToString(), DisplayText(dl))).ToList())"
                                      Value="@_selectedDriveline"
                                      ValueChanged="OnDrivelineChanged"
                                      Disabled="@(string.IsNullOrEmpty(_selectedModel) || _loadingDrivelines)" />
                </div>

                <div class="vehicle-select-group">
                    <label class="vehicle-select-label" for="vp-trimlevel-inline">Trim Level</label>
                    <SearchableSelect @ref="_trimLevelSelect"
                                      Id="vp-trimlevel-inline"
                                      Placeholder="@(_loadingTrimLevels ? "Loading..." : "Trim Level")"
                                      SearchPlaceholder="Search trim levels..."
                                      Options="@(_trimLevels.Select(tl => new SearchableSelectOption(tl.Ukey.ToString(), DisplayText(tl))).ToList())"
                                      Value="@_selectedTrimLevel"
                                      ValueChanged="OnTrimLevelChanged"
                                      Disabled="@(string.IsNullOrEmpty(_selectedDriveline) || _loadingTrimLevels)" />
                </div>
            }

            <button class="vehicle-picker-inline-submit"
                    disabled="@(!IsVehicleComplete)"
                    @onclick="Submit">
                @ResolvedSubmitLabel
            </button>
        </div>
    </section>
}
