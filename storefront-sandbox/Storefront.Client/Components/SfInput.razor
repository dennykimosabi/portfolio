<div class="sf-field @Class" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sf-field-label" for="@_id">@Label</label>
    }
    <input id="@_id"
           type="@Type"
           class="sf-input @(Invalid ? "is-invalid" : null)"
           placeholder="@Placeholder"
           disabled="@Disabled"
           aria-invalid="@Invalid"
           @bind="Value"
           @bind:event="oninput" />
    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="sf-field-error" role="alert">@Error</p>
    }
    @if (!string.IsNullOrEmpty(Hint))
    {
        <p class="sf-field-hint">@Hint</p>
    }
</div>

@code {
    private readonly string _id = $"sf-input-{Guid.NewGuid():N}";

    /// <summary>Additional CSS classes applied to the component root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional attributes splatted onto the component root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Label text. Renders a linked &lt;label&gt; when set.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Input value. Supports two-way binding.</summary>
    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>Invoked when the value changes.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>HTML input type.</summary>
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>Placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Disables the input.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Marks the input invalid and applies error styling.</summary>
    [Parameter] public bool Invalid { get; set; }

    /// <summary>Error message shown under the input.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>Hint text shown under the input.</summary>
    [Parameter] public string? Hint { get; set; }
}
