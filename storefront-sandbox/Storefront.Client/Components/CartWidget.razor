@if (!HideCart)
{
    <div class="cart-widget @Class" @attributes="AdditionalAttributes">
        <button type="button"
                class="cart-widget-btn @(_isOpen ? "is-open" : "")"
                aria-label="@($"Cart - {CartState.ItemCount} item{(CartState.ItemCount == 1 ? "" : "s")}")"
                aria-expanded="@_isOpen"
                @onclick="TogglePanel">
            @* Icon: Remix Icon "shopping-cart-line" — matches CartIcon.razor elsewhere in the app. *@
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4.00488 16V4H2.00488V2H5.00488C5.55717 2 6.00488 2.44772 6.00488 3V15H18.4433L20.4433 7H8.00488V5H21.7241C22.2764 5 22.7241 5.44772 22.7241 6C22.7241 6.08176 22.7141 6.16322 22.6942 6.24254L20.1942 16.2425C20.083 16.6877 19.683 17 19.2241 17H5.00488C4.4526 17 4.00488 16.5523 4.00488 16ZM6.00488 23C4.90031 23 4.00488 22.1046 4.00488 21C4.00488 19.8954 4.90031 19 6.00488 19C7.10945 19 8.00488 19.8954 8.00488 21C8.00488 22.1046 7.10945 23 6.00488 23ZM18.0049 23C16.9003 23 16.0049 22.1046 16.0049 21C16.0049 19.8954 16.9003 19 18.0049 19C19.1095 19 20.0049 19.8954 20.0049 21C20.0049 22.1046 19.1095 23 18.0049 23Z" />
            </svg>
            <span class="cart-widget-count">@CartState.ItemCount</span>
        </button>

        @if (_isOpen)
        {
            <div class="cart-widget-overlay" @onclick="ClosePanel"></div>

            <aside class="cart-widget-panel" aria-label="Cart contents">
                <header class="cart-widget-header">
                    <h2 class="cart-widget-title">Your Cart</h2>
                    <button type="button" class="cart-widget-close" @onclick="ClosePanel" aria-label="Close cart">×</button>
                </header>

                <div class="cart-widget-body">
                    @if (CartState.IsLoadingContents)
                    {
                        <LoadingIndicator Text="Loading cart…" />
                    }
                    else if (CartState.Items.Count == 0)
                    {
                        <div class="cart-widget-empty">
                            <p>Your cart is empty</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in CartState.Items)
                        {
                            <div class="cart-widget-item">
                                <a href="@item.ProductURL" class="cart-widget-item-img">
                                    @if (!string.IsNullOrWhiteSpace(item.ThumbnailURL))
                                    {
                                        <img src="@item.ThumbnailURL" alt="@HtmlHelper.StripHtml(item.ProductDescription)" />
                                    }
                                </a>
                                <div class="cart-widget-item-info">
                                    <a href="@item.ProductURL" class="cart-widget-item-title">@HtmlHelper.StripHtml(item.ProductDescription)</a>
                                    <p class="cart-widget-item-meta">Part #: @item.StockCode &middot; Qty: @item.Quantity</p>
                                </div>
                                <span class="cart-widget-item-price">@item.LineItemTotal.ToString("C")</span>
                                <button type="button" class="cart-widget-item-remove" aria-label="Remove item" @onclick="() => CartState.RemoveItemAsync(item)">×</button>
                            </div>
                        }
                    }
                </div>

                @if (!CartState.IsLoadingContents && CartState.Summary.Count > 0)
                {
                    <div class="cart-widget-summary">
                        @foreach (var line in CartState.Summary)
                        {
                            // Prefer the clean PlainName; fall back to CartSummary (HTML-wrapped in the sproc) so
                            // rows like MSRP that ship without a PlainName still get a label. Skip the row entirely
                            // if both labels are empty — avoids the orphan "$589.02" with no name.
                            var label = !string.IsNullOrWhiteSpace(line.PlainName)
                                ? HtmlHelper.StripHtml(line.PlainName)
                                : HtmlHelper.StripHtml(line.CartSummary);

                            if (string.IsNullOrWhiteSpace(label)) continue;

                            <div class="cart-widget-summary-line @(line.IsTotal ? "is-total" : "")">
                                <span>@label</span>
                                <span>@HtmlHelper.StripHtml(line.DisplayAmount)</span>
                            </div>
                        }
                    </div>
                }

                <footer class="cart-widget-footer">
                    <button type="button" class="cart-widget-continue" @onclick="ClosePanel">Continue Shopping</button>
                    <a href="/cart" class="cart-widget-view">View Cart</a>
                    <button type="button" class="cart-widget-checkout" disabled="@(CartState.ItemCount == 0)">Checkout</button>
                </footer>
            </aside>
        }
    </div>
}
