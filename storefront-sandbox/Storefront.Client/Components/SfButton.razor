@if (!string.IsNullOrEmpty(Href))
{
    <a href="@Href" target="@Target"
       class="sf-button sf-button-@VariantClass sf-button-@SizeClass @Class"
       aria-label="@AriaLabel"
       aria-disabled="@IsDisabled"
       @onclick="HandleClick"
       @attributes="AdditionalAttributes">@ButtonContent</a>
}
else
{
    <button type="@TypeAttr"
            class="sf-button sf-button-@VariantClass sf-button-@SizeClass @Class"
            disabled="@IsDisabled"
            aria-label="@AriaLabel"
            aria-disabled="@IsDisabled"
            aria-busy="@Loading"
            @onclick="HandleClick"
            @attributes="AdditionalAttributes">@ButtonContent</button>
}
