@if (_settings is not null)
{
    <aside class="confidence-panel @Class" @attributes="AdditionalAttributes" aria-label="Shop with confidence">
        <header class="confidence-panel-header">
            <h2 class="confidence-panel-title">@Title</h2>
        </header>
        <div class="confidence-panel-body">
            <div class="confidence-secure-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <polyline points="9 12 11 14 15 10" />
                </svg>
            </div>

            <p class="confidence-message">@Text</p>

            @if (_hasAnyContactItem)
            {
                <div class="confidence-contact">
                    <p class="confidence-contact-heading">Contact Customer Service</p>
                    <ul class="confidence-contact-list">
                        @if (_hasPhone)
                        {
                            <li class="confidence-contact-item confidence-icon-phone">
                                <a href="tel:@PhoneHref" title="@($"Call {_settings.BusinessName}")">@PhoneDisplay</a>
                            </li>
                        }
                        @if (_hasEmail)
                        {
                            <li class="confidence-contact-item confidence-icon-email">
                                <a href="mailto:@_settings.SalesEmail" title="@($"Email {_settings.BusinessName}")">Email Us</a>
                            </li>
                        }
                        @if (_hasReturnPolicy)
                        {
                            <li class="confidence-contact-item confidence-icon-return">
                                <a href="/policy" title="@($"View {_settings.BusinessName} return policy")">Return Policy</a>
                            </li>
                        }
                        @if (_showMyProfile)
                        {
                            <li class="confidence-contact-item confidence-icon-profile">
                                <a href="/myProfile" title="View your profile">My Profile</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </aside>
}
