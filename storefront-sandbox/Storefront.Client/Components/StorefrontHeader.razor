@if (Settings is null) { return; }
<header class="storefront-header">

    @if (!string.IsNullOrWhiteSpace(H1TagText))
    {
        <div class="header-h1-bar">
            <h1>@H1TagText</h1>
        </div>
    }

    <div class="header-dealer-bar">
        <div class="header-inner">
            <span class="dealer-name">@Settings.BusinessName</span>
            <div class="dealer-contact">
                @if (!string.IsNullOrWhiteSpace(Settings.FormattedAddress))
                {
                    <span class="dealer-address">@Settings.FormattedAddress</span>
                }
                @if (!string.IsNullOrWhiteSpace(Settings.PhoneNumber))
                {
                    <span class="dealer-phone">@Settings.PhoneNumber</span>
                }
                @if (!string.IsNullOrWhiteSpace(Settings.SalesEmail))
                {
                    <span class="dealer-email">@Settings.SalesEmail</span>
                }
            </div>
        </div>
    </div>

    <div class="header-main-nav">
        <div class="header-inner">

            <a href="/" class="header-logo" aria-label="Home">
                @if (!string.IsNullOrWhiteSpace(Settings.LogoUrl))
                {
                    <img src="@Settings.LogoUrl" alt="@Settings.ManufacturerName" class="header-logo-img" />
                }
            </a>

            <nav class="header-nav-links" aria-label="Site navigation">
                <a href="/" class="header-nav-link">Home</a>
                <a href="/accessories" class="header-nav-link">Accessories</a>
                <a href="/lifestyle" class="header-nav-link">Lifestyle</a>
            </nav>

            @if (_isSearchOpen)
            {
                <div class="header-search-overlay" @onclick="CloseSearch"></div>
            }
            <form class="header-search @(_isSearchOpen ? "is-open" : "")" @onsubmit="HandleSearch" @onsubmit:preventDefault>
                <button type="@(_isSearchOpen ? "submit" : "button")" class="header-search-icon-btn" aria-label="Search" @onclick="OpenSearch">
                    @* Icon: Remix Icon "search-line". *@
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247L16.0247 15.8748Z" />
                    </svg>
                </button>
                <input @ref="_searchInputRef"
                       type="text"
                       class="header-search-input"
                       placeholder="Search by Keywords, Part Numbers or Full VIN"
                       aria-label="Search"
                       @bind="_searchInput"
                       @bind:event="oninput" />
            </form>

            <div class="header-vehicle-selector">
                @* @key disambiguates from the Inline VehiclePicker on the home page. *@
                <VehiclePicker @key="@("vp-panel-header")" Layout="VehiclePickerLayout.Panel" />
            </div>

            <div class="header-actions">
                <CartWidget HideCart="@Settings.HideCart" />
                <button class="header-menu-btn" aria-label="Menu">
                    <span class="menu-bar"></span>
                    <span class="menu-bar"></span>
                    <span class="menu-bar"></span>
                </button>
            </div>

        </div>
    </div>

</header>
