<div class="search-results-toolbar @Class" @attributes="AdditionalAttributes">
    <div class="toolbar-row toolbar-row-top">
        <h1 class="results-title">Results for <span class="results-term">@FitmentString</span></h1>
        @if (CatalogCount > 0 && !string.IsNullOrEmpty(CatalogTermLabel))
        {
            <p class="results-catalog-info">Our catalog includes <strong>@CatalogCount</strong> @CatalogTermLabel Products.</p>
        }
    </div>
    <div class="toolbar-row toolbar-row-bottom">
        <SfButton Variant="SfButtonVariant.Outline" Size="SfButtonSize.Sm" OnClick="ToggleSidebar">
            <SfIcon Name="filter-3-line" />
            @(ShowSidebar ? "Hide Filters" : "Show Filters")@(FilterCount > 0 ? $" ({FilterCount})" : "")
        </SfButton>
        <div class="results-controls">
            <SfButtonGroup AriaLabel="Results per page">
                <SfButton Variant="SfButtonVariant.Outline" Size="SfButtonSize.Sm" Class="@(_pageSize == 50 ? "is-active" : null)" OnClick="@(() => _pageSize = 50)">50</SfButton>
                <SfButton Variant="SfButtonVariant.Outline" Size="SfButtonSize.Sm" Class="@(_pageSize == 100 ? "is-active" : null)" OnClick="@(() => _pageSize = 100)">100</SfButton>
                <SfButton Variant="SfButtonVariant.Outline" Size="SfButtonSize.Sm" Class="@(_pageSize == 250 ? "is-active" : null)" OnClick="@(() => _pageSize = 250)">250</SfButton>
            </SfButtonGroup>
            <SfSelect aria-label="Sort by" Value="@SortValue" ValueChanged="HandleSortChanged" Options="@SortOptions" Class="toolbar-sort" />
            <SfButtonGroup AriaLabel="View mode">
                <SfButton Variant="SfButtonVariant.Outline" Size="SfButtonSize.IconSm" AriaLabel="List view" Class="@(!IsGridView ? "is-active" : null)" OnClick="HandleListView">
                    <SfIcon Name="list-unordered" />
                </SfButton>
                <SfButton Variant="SfButtonVariant.Outline" Size="SfButtonSize.IconSm" AriaLabel="Grid view" Class="@(IsGridView ? "is-active" : null)" OnClick="HandleGridView">
                    <SfIcon Name="layout-grid-line" />
                </SfButton>
            </SfButtonGroup>
        </div>
    </div>
</div>
