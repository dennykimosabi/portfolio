@inherits LayoutComponentBase
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pf-shell">
    <button class="pf-menu-btn" @onclick="ToggleNav" aria-expanded="@_navOpen" aria-controls="pfSidebar" aria-label="Open navigation">
        <i class="ri-menu-line" aria-hidden="true"></i>
    </button>
    @if (_navOpen)
    {
        <div class="pf-nav-overlay" @onclick="CloseNav" aria-hidden="true"></div>
    }
    <aside id="pfSidebar" class="pf-sidebar @(_navOpen ? "is-open" : "")" aria-label="Portfolio navigation" tabindex="-1">
        <a class="pf-brand" href="" @onclick="CloseNav">
            <span class="pf-brand-mark">DK</span>
            <span class="pf-brand-text">
                <strong>Denny Kim</strong>
                <small>design component catalog</small>
            </span>
        </a>
        <nav class="pf-nav" @onclick="CloseNav">
            <NavLink class="pf-nav-item" href="" Match="NavLinkMatch.All">
                <span class="pf-nav-icon">&#8962;</span> Home
            </NavLink>
            <NavLink class="pf-nav-item" href="workshop">
                <span class="pf-nav-icon">&#9638;</span> Workshop
            </NavLink>
            <NavLink class="pf-nav-item" href="blueprints">
                <span class="pf-nav-icon">&#9635;</span> Blueprints
            </NavLink>
            <NavLink class="pf-nav-item" href="flows">
                <span class="pf-nav-icon">&#8646;</span> Flows
            </NavLink>
            <NavLink class="pf-nav-item" href="build-log">
                <span class="pf-nav-icon">&#9776;</span> Build log
            </NavLink>
            <NavLink class="pf-nav-item" href="experiments">
                <span class="pf-nav-icon">&#9734;</span> Experiments
            </NavLink>
            <NavLink class="pf-nav-item" href="archive">
                <span class="pf-nav-icon">&#9783;</span> Archive
            </NavLink>
            <NavLink class="pf-nav-item" href="about">
                <span class="pf-nav-icon">&#9786;</span> About
            </NavLink>
        </nav>
        <div class="pf-sidebar-foot">
            <small>Built with Blazor +<br />AI-assisted development</small>
        </div>
    </aside>
    <main class="pf-main">
        @Body
    </main>
</div>

@code {
    private bool _navOpen;
    private DotNetObjectReference<PortfolioLayout>? _ref;

    private async Task ToggleNav()
    {
        _navOpen = !_navOpen;
        await JS.InvokeVoidAsync("pfDrawer.lockScroll", _navOpen);
        if (_navOpen)
            await JS.InvokeVoidAsync("pfDrawer.focus");
    }

    private async Task CloseNav()
    {
        if (!_navOpen) return;
        _navOpen = false;
        await JS.InvokeVoidAsync("pfDrawer.lockScroll", false);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task CloseDrawer() => await CloseNav();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pfDrawer.init", _ref);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _ref?.Dispose();
        try { await JS.InvokeVoidAsync("pfDrawer.lockScroll", false); } catch { /* shutdown */ }
    }
}
