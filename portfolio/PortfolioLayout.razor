@inherits LayoutComponentBase
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pf-shell">
    <button class="pf-menu-btn" @onclick="ToggleNav" aria-expanded="@_navOpen" aria-controls="pfSidebar" aria-label="Open navigation">
        <i class="ri-menu-line" aria-hidden="true"></i>
    </button>
    @if (_navOpen)
    {
        <div class="pf-nav-overlay" @onclick="CloseNav" aria-hidden="true"></div>
    }
    <aside id="pfSidebar" class="pf-sidebar @(_navOpen ? "is-open" : "") @(_rail ? "is-rail" : "")" aria-label="Portfolio navigation" tabindex="-1">
        <a class="pf-brand" href="" @onclick="CloseNav" title="Denny Kim">
            <span class="pf-brand-mark">DK</span>
            <span class="pf-brand-text">
                <strong>Denny Kim</strong>
                <small>design component catalog</small>
            </span>
        </a>
        <nav class="pf-nav" @onclick="CloseNav">
            <NavLink class="pf-nav-item" href="" Match="NavLinkMatch.All" title="Home">
                <span class="pf-nav-icon"><i class="ri-home-5-line" aria-hidden="true"></i></span> <span class="pf-nav-label">Home</span>
            </NavLink>
            <p class="pf-nav-group-label">Catalog</p>
            <NavLink class="pf-nav-item" href="workshop" title="Workshop">
                <span class="pf-nav-icon"><i class="ri-tools-line" aria-hidden="true"></i></span> <span class="pf-nav-label">Workshop</span>
            </NavLink>
            <div class="pf-nav-parent">
                @if (_rail)
                {
                    <button type="button" class="pf-nav-item pf-nav-toggle @(IsBlueprintsActive ? "active" : "")"
                            @onclick="ToggleBlueprints" @onclick:stopPropagation="true"
                            aria-expanded="@_blueprintsOpen" title="Blueprints">
                        <span class="pf-nav-icon"><i class="ri-draft-line" aria-hidden="true"></i></span> <span class="pf-nav-label">Blueprints</span>
                        <i class="ri-arrow-right-s-line pf-nav-flychevron" aria-hidden="true"></i>
                    </button>
                    @if (_blueprintsOpen)
                    {
                        <div class="pf-rail-flyout" @onclick:stopPropagation="true">
                            <NavLink class="pf-flyout-item" href="blueprints" @onclick="CloseBlueprints">All blueprints</NavLink>
                            @foreach (var (href, label) in BlueprintPages)
                            {
                                <NavLink class="pf-flyout-item" href="@href" @onclick="CloseBlueprints">@label</NavLink>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="pf-nav-row">
                        <NavLink class="pf-nav-item pf-nav-link" href="blueprints" title="Blueprints">
                            <span class="pf-nav-icon"><i class="ri-draft-line" aria-hidden="true"></i></span> <span class="pf-nav-label">Blueprints</span>
                        </NavLink>
                        <button type="button" class="pf-nav-chevron" @onclick="ToggleBlueprints" @onclick:stopPropagation="true"
                                aria-expanded="@_blueprintsOpen" aria-label="Toggle blueprint pages">
                            <i class="@(_blueprintsOpen ? "ri-arrow-down-s-line" : "ri-arrow-right-s-line")" aria-hidden="true"></i>
                        </button>
                    </div>
                    @if (_blueprintsOpen)
                    {
                        <div class="pf-nav-children">
                            @foreach (var (href, label) in BlueprintPages)
                            {
                                <NavLink class="pf-nav-child" href="@href">@label</NavLink>
                            }
                        </div>
                    }
                }
            </div>
            <p class="pf-nav-group-label">Process</p>
            <NavLink class="pf-nav-item" href="flows" title="Flows">
                <span class="pf-nav-icon"><i class="ri-route-line" aria-hidden="true"></i></span> <span class="pf-nav-label">Flows</span>
            </NavLink>
            <NavLink class="pf-nav-item" href="build-log" title="Build log">
                <span class="pf-nav-icon"><i class="ri-history-line" aria-hidden="true"></i></span> <span class="pf-nav-label">Build log</span>
            </NavLink>
            <NavLink class="pf-nav-item" href="experiments" title="Experiments">
                <span class="pf-nav-icon"><i class="ri-flask-line" aria-hidden="true"></i></span> <span class="pf-nav-label">Experiments</span>
            </NavLink>
            <NavLink class="pf-nav-item" href="archive" title="Archive">
                <span class="pf-nav-icon"><i class="ri-archive-line" aria-hidden="true"></i></span> <span class="pf-nav-label">Archive</span>
            </NavLink>
            <NavLink class="pf-nav-item" href="about" title="About">
                <span class="pf-nav-icon"><i class="ri-information-line" aria-hidden="true"></i></span> <span class="pf-nav-label">About</span>
            </NavLink>
        </nav>
        <button type="button" class="pf-rail-toggle" @onclick="ToggleRail" aria-label="@(_rail ? "Expand sidebar" : "Collapse sidebar to icons")" title="@(_rail ? "Expand sidebar" : "Collapse sidebar")">
            <i class="@(_rail ? "ri-sidebar-unfold-line" : "ri-sidebar-fold-line")" aria-hidden="true"></i>
        </button>
        <div class="pf-sidebar-foot">
            <small>Built with Blazor +<br />AI-assisted development</small>
        </div>
    </aside>
    <main class="pf-main">
        @Body
    </main>
</div>

@code {
    private bool _navOpen;          // mobile drawer
    private bool _rail;             // desktop icon rail
    private bool _blueprintsOpen;   // subcategories expanded
    private DotNetObjectReference<PortfolioLayout>? _ref;

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private static readonly (string Href, string Label)[] BlueprintPages = new[]
    {
        ("blueprints/home", "Home"),
        ("blueprints/search", "Search"),
        ("blueprints/product", "Product"),
        ("blueprints/cart", "Cart"),
        ("blueprints/accessories", "Accessories"),
    };

    private bool IsBlueprintsActive =>
        Nav.ToBaseRelativePath(Nav.Uri).StartsWith("blueprints", StringComparison.OrdinalIgnoreCase);

    private void ToggleBlueprints() => _blueprintsOpen = !_blueprintsOpen;
    private void CloseBlueprints() => _blueprintsOpen = false;

    private async Task ToggleRail()
    {
        _rail = !_rail;
        try { await JS.InvokeVoidAsync("pfDrawer.setRail", _rail); } catch { /* prerender */ }
    }

    private async Task ToggleNav()
    {
        _navOpen = !_navOpen;
        await JS.InvokeVoidAsync("pfDrawer.lockScroll", _navOpen);
        if (_navOpen)
            await JS.InvokeVoidAsync("pfDrawer.focus");
    }

    private async Task CloseNav()
    {
        if (!_navOpen) return;
        _navOpen = false;
        await JS.InvokeVoidAsync("pfDrawer.lockScroll", false);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task CloseDrawer() => await CloseNav();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pfDrawer.init", _ref);
            try
            {
                _rail = await JS.InvokeAsync<bool>("pfDrawer.getRail");
                // Auto-expand subcategories when on a blueprint detail page.
                if (IsBlueprintsActive) _blueprintsOpen = true;
                StateHasChanged();
            }
            catch { /* storage unavailable */ }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _ref?.Dispose();
        try { await JS.InvokeVoidAsync("pfDrawer.lockScroll", false); } catch { /* shutdown */ }
    }
}
