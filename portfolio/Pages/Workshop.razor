        StateHasChanged();
        await Task.Delay(600);
        _estimateText = $"Estimated shipping: {7.95m + 1.50m * Math.Max(0, _quantity - 1):C}";
        _estimating = false;
    }

    private void ZipChanged(string zip)
    {
        _delivery = _delivery with { ZipCode = zip };
        _estimateText = null;
        _priceBoxEvent = $"OnZipCodeChanged(\"{zip}\")";
    }

    private bool _accordionOpen;
}
