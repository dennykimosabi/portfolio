    private string? _cartMessage;

    private async Task AddSearchResultToCart(ProductSearchResult p)
    {
        await CartState.AddToCartAsync(p.Ukey);
        _cartMessage = $"Added “{p.ProductDescription}” — cart now has {CartState.ItemCount} items.";
    }

    private async Task AddRelatedToCart(RelatedProduct p)
    {
        await CartState.AddToCartAsync(p.UkeyProduct);
        _cartMessage = $"Added “{p.Title}” — cart now has {CartState.ItemCount} items.";
    }

