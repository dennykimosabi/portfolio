    private int _quantity = 1;
    private string _priceBoxEvent = "—";
    private bool _estimating;
    private string? _estimateText;
    private DeliveryOption _delivery = new(ZipCode: "62701", Promise: "Ships in 1-2 business days");
    private readonly PickupOption _pickup = new(Promise: "Ready for pickup today", CostText: "FREE");

    private async Task EstimateShippingAsync()
    {
        _estimating = true;
        _priceBoxEvent = "OnEstimateShipping";
        StateHasChanged();
        await Task.Delay(600);
        _estimateText = $"Estimated shipping: {7.95m + 1.50m * Math.Max(0, _quantity - 1):C}";
        _estimating = false;
    }

    private void ZipChanged(string zip)
    {
        _delivery = _delivery with { ZipCode = zip };
        _estimateText = null;
        _priceBoxEvent = $"OnZipCodeChanged(\"{zip}\")";
    }

