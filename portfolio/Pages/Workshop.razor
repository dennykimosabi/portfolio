        new("+ Brakes category", 2024, 101, 201, 302, 11),
        new("+ Cargo & Storage", 2024, 101, 201, 302, 51),
    ];

    private bool IsActive(Preset p) =>
        FitmentState.Year == p.Year && FitmentState.UkeyModel == p.Model && FitmentState.UkeyDriveline == p.Driveline
        && FitmentState.UkeyTrimLevel == p.Trim && FitmentState.UkeyCategory == p.Category;

    private void Apply(Preset p) =>
        FitmentState.SetVehicleAndCategory(DemoCatalog.MakeUkey, p.Year, p.Model, p.Driveline, p.Trim, p.Category);

    private string CurrentFitmentLabel
    {
        get
        {
            var vehicle = FitmentState.HasVehicle
                ? DemoCatalog.FitmentString(FitmentState.Year, FitmentState.UkeyModel, FitmentState.UkeyDriveline, FitmentState.UkeyTrimLevel)
                : "No vehicle";
            return CategoryByUkey(FitmentState.UkeyCategory) is { } c ? $"{vehicle} · {c.Name}" : vehicle;
        }
    }

    private static DemoCategory? CategoryByUkey(int? ukey) => DemoCatalog.CategoryByUkey(ukey);

    protected override void OnInitialized() => FitmentState.OnChange += HandleFitmentChanged;

    private void HandleFitmentChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => FitmentState.OnChange -= HandleFitmentChanged;

