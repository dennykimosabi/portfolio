@* ⌘K command palette for v2 — mirrors the Design Studio's global palette:
   grouped entries (Blueprints / Workshop / Docs), keyboard navigable, closes on select. *@
@inject NavigationManager Nav

@if (_open)
{
    <div class="v2-palette-overlay" @onclick="Close" aria-hidden="true"></div>
    <div class="v2-palette" role="dialog" aria-modal="true" aria-label="Command palette">
        <div class="v2-palette-input-row">
            <i class="ri-search-line" aria-hidden="true"></i>
            <input @ref="_input" class="v2-palette-input" placeholder="Search the studio…"
                   @bind="_query" @bind:event="oninput" @onkeydown="OnKeyDown" />
            <kbd>esc</kbd>
        </div>
        <div class="v2-palette-results">
            @{
                var groups = Filtered().GroupBy(e => e.Section).ToList();
                var idx = 0;
            }
            @foreach (var g in groups)
            {
                <p class="v2-palette-group">@g.Key</p>
                @foreach (var e in g)
                {
                    var i = idx++;
                    <button type="button" class="v2-palette-item @(i == _active ? "is-active" : "")"
                            @onclick="() => Go(e.Href)" @onmouseenter="() => _active = i">
                        <i class="ri-arrow-right-line" aria-hidden="true"></i>
                        <span>@e.Label</span>
                    </button>
                }
            }
            @if (!groups.Any())
            {
                <p class="v2-palette-empty">No matches.</p>
            }
        </div>
    </div>
}

@code {
    private bool _open;
    private string _query = "";
    private int _active;
    private ElementReference _input;

    public void Open()
    {
        _open = true;
        _query = "";
        _active = 0;
        StateHasChanged();
    }

    public void Close()
    {
        _open = false;
        StateHasChanged();
    }

    private List<(string Href, string Label, string Section)> Filtered()
    {
        var q = _query.Trim();
        var all = V2NavData.AllEntries();
        if (string.IsNullOrEmpty(q)) return all.Take(12).ToList();
        return all.Where(e => e.Label.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void Go(string href)
    {
        Close();
        Nav.NavigateTo(href);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        var count = Filtered().Count;
        if (e.Key == "Escape") Close();
        else if (e.Key == "ArrowDown") { _active = Math.Min(_active + 1, count - 1); }
        else if (e.Key == "ArrowUp") { _active = Math.Max(_active - 1, 0); }
        else if (e.Key == "Enter")
        {
            var item = Filtered().ElementAtOrDefault(_active);
            if (item != default) Go(item.Href);
        }
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && _input.Context != null)
        {
            try { await _input.FocusAsync(); } catch { }
        }
    }
}
