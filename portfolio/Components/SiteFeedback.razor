@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Routing
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Point-and-comment site feedback. Always visible. *@
<div data-site-feedback>
        @if (!_picking && _pick is null)
        {
            <button class="sfb-fab" @onclick="StartPick" title="Point at something to comment on">
                <i class="ri-chat-3-line" aria-hidden="true"></i> Annotate
            </button>
        }
        @if (_picking)
        {
            <div class="sfb-banner">
                Click anything on the page to comment on it.
                <button class="sfb-link" @onclick="CancelPick">Cancel (Esc)</button>
            </div>
        }
        @if (_pick is not null)
        {
            <div class="sfb-composer" style="@_composerStyle">
                <div class="sfb-composer-caption" title="@_pick.Selector">
                    <span>@_pick.Label</span>
                    <button type="button" class="sfb-tool" @onclick="CancelPick" title="Discard" aria-label="Discard comment">
                        <i class="ri-close-line" aria-hidden="true"></i>
                    </button>
                </div>
                <textarea class="sfb-composer-input" rows="2" placeholder="Write a comment…"
                          @bind="_comment" @bind:event="oninput" autofocus></textarea>
                <div class="sfb-composer-toolbar">
                    <button type="button" class="sfb-tool" title="Add attachment" aria-label="Add attachment">
                        <i class="ri-add-line" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="sfb-tool" title="Add screenshot" aria-label="Add screenshot">
                        <i class="ri-camera-line" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="sfb-tool sfb-tool-text" title="Formatting" aria-label="Formatting">Aa</button>
                    <span class="sfb-composer-spacer"></span>
                    @if (_copied)
                    {
                        <span class="sfb-copied">Copied — paste it into chat</span>
                    }
                    else
                    {
                        <button type="button" class="sfb-send" @onclick="CopyFeedback"
                                disabled="@string.IsNullOrWhiteSpace(_comment)"
                                title="Copy feedback" aria-label="Send feedback">
                            <i class="ri-send-plane-fill" aria-hidden="true"></i>
                        </button>
                    }
                </div>
            </div>
        }
</div>

@code {
    private bool _picking;
    private PickInfo? _pick;
    private string _comment = string.Empty;
    private bool _copied;
    private string _composerStyle = string.Empty;
    private DotNetObjectReference<SiteFeedback>? _ref;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
        }
    }

    private async Task StartPick()
    {
        _picking = true;
        _pick = null;
        _comment = string.Empty;
        _copied = false;
        await JS.InvokeVoidAsync("siteFeedback.start", _ref);
    }

    [JSInvokable]
    public async Task OnElementPicked(PickInfo pick)
    {
        _pick = pick;
        _picking = false;
        // Anchor the composer near the click, clamped inside the viewport.
        const int w = 340, h = 230;
        var left = Math.Min(pick.X + 12, Math.Max(8, pick.Vw - w - 8));
        var top = pick.Y + 16 + h > pick.Vh
            ? Math.Max(8, pick.Y - h - 12)
            : pick.Y + 16;
        _composerStyle = $"left:{left}px;top:{top}px;";
        await JS.InvokeVoidAsync("siteFeedback.stop");
        StateHasChanged();
    }

    [JSInvokable]
    public async Task CancelPick()
    {
        _picking = false;
        _pick = null;
        _comment = string.Empty;
        _copied = false;
        await JS.InvokeVoidAsync("siteFeedback.stop");
        StateHasChanged();
    }

    private async Task CopyFeedback()
    {
        var text = $"[site-feedback]\nPage: {_pick!.Page}\nElement: {_pick.Label}\nSelector: {_pick.Selector}\nNote: {_comment.Trim()}";
        await JS.InvokeVoidAsync("siteFeedback.copyText", text);
        _copied = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (_ref is not null)
        {
            try { await JS.InvokeVoidAsync("siteFeedback.stop"); } catch { }
            _ref.Dispose();
        }
    }

    public sealed class PickInfo
    {
        public string Selector { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Page { get; set; } = string.Empty;
        public int X { get; set; }
        public int Y { get; set; }
        public int Vw { get; set; }
        public int Vh { get; set; }
    }
}
